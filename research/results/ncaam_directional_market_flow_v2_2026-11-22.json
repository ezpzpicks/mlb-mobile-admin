    "semantics": {
      "line": "Independent signed line points, even with flat/missing money. Rising totals favor Over; improving a team's handicap favors that team.",
      "money": "Recent ordered share changes, no opening-to-current direction clamp.",
      "divergence": "Growing money against declining ticket share strengthens that money-side interpretation.",
      "ticket_only": "Observed flat money plus growing tickets weakens relative money backing for that side; this contrarian interpretation is a declared research prior.",
      "degree": "Line points and ten-percentage-point split changes enter continuously before the declared floor/caps.",
      "reversals": "Recent intervals can supersede the opening-to-current direction, including histories ending at their opening money share.",
      "timing": "Independent price evidence; separate same-window and later-price-confirming-earlier-money channels.",
      "updates": "Recompute from unadjusted baseline on each paired snapshot; never compound a previous full correction.",
      "persistence": "Unchanged shares preserve the split evidence until a new split change arrives; price-only moves remain independent and cannot change the split clock."
    },
